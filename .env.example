POSTGRES_DB=applywise
POSTGRES_USER=applywise
POSTGRES_PASSWORD=applywise_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://applywise:applywise_dev@localhost:5432/applywise
APP_ENV=development
# Also signs F01 JWT access tokens. Generate a real per-environment secret
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
# outside local development; never commit a real value.
APP_SECRET_KEY=replace-me-locally-with-a-random-32-byte-secret
# stub and demo are offline and deterministic. anthropic calls the real
# Messages API and needs AI_API_KEY; its output is not reproducible, which
# is intended -- F08 verification runs on whatever it returns.
AI_PROVIDER=stub
AI_API_KEY=
# Only used by a real provider. Aliases move with new releases, so set this
# per environment; GET https://api.anthropic.com/v1/models lists valid ids.
AI_MODEL=claude-sonnet-4-5

# F01: authentication / RBAC
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
