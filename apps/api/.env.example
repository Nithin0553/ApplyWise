# Local, Docker-free evaluation configuration. Copy to apps/api/.env.
# Do not commit .env or put a real API key in this file.
APP_ENV=development
DATABASE_URL=sqlite:///./local.db
APP_SECRET_KEY=replace-this-with-any-random-32-character-string
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
